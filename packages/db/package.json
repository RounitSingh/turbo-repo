    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@repo/logger": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "5.9.2"
  }
